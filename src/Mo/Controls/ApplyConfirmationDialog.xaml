<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Mo.Controls.ApplyConfirmationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    DefaultButton="Primary"
    Opened="ContentDialog_Opened"
    Closed="ContentDialog_Closed">

    <StackPanel Spacing="16" MinWidth="320">
        <TextBlock
            x:Name="CountdownText"
            Style="{StaticResource BodyTextBlockStyle}"
            AutomationProperties.LiveSetting="Polite"
            TextWrapping="Wrap" />

        <!-- Not a ProgressBar: its Value is a dependent (UI-thread) property, so a
             countdown driven through it either steps once a second or costs a frame
             callback. A ScaleTransform on a plain Border animates on the composition
             thread instead, and filling left-to-right reads as time running out rather
             than as progress being undone. -->
        <Grid
            Height="4"
            CornerRadius="2"
            Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
            AutomationProperties.AccessibilityView="Raw">
            <Border
                x:Name="CountdownFill"
                CornerRadius="2"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="CountdownScale" ScaleX="0" />
                </Border.RenderTransform>
            </Border>
        </Grid>
    </StackPanel>
</ContentDialog>
