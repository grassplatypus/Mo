<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Mo.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- LeftCompact, not Left: the rail holds two destinations plus Settings, and the
         expanded pane spent a third of a 1000px window on them. The toggle button is
         still there for anyone who wants the labels, and each item carries a ToolTip
         so the icon-only state stays readable. OpenPaneLength is trimmed to match the
         longest label rather than the 320px default. -->
    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Auto"
        IsSettingsVisible="True"
        IsPaneToggleButtonVisible="True"
        OpenPaneLength="220"
        BackRequested="NavView_BackRequested"
        ItemInvoked="NavView_ItemInvoked"
        PaneDisplayMode="LeftCompact">

        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="NavProfilesItem" Tag="Profiles">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7F4;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="NavDisplayTuningItem" Tag="DisplayTuning">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE706;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
