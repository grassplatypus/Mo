<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Mo.Views.ProfileListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Mo.Views"
    xmlns:controls="using:Mo.Controls"
    xmlns:models="using:Mo.Models"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Transitions>
        <TransitionCollection>
            <EntranceThemeTransition />
        </TransitionCollection>
    </Page.Transitions>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="NewLayoutBtn" Click="NewLayoutButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7C4;" FontSize="14" />
                        <TextBlock x:Name="NewLayoutText" />
                    </StackPanel>
                </Button>

                <!-- Import is a secondary action; only "save current setup" gets accent
                     styling. Two accent buttons side by side gave neither any weight. -->
                <Button x:Name="ImportBtn" Click="ImportButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                        <TextBlock x:Name="ImportText" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="SaveCurrentBtn"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SaveCurrentButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Name="SaveCurrentText" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Profile List -->
        <GridView
            Grid.Row="1"
            x:Name="ProfileGrid"
            ItemsSource="{x:Bind ViewModel.Profiles}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            SizeChanged="ProfileGrid_SizeChanged"
            ItemClick="ProfileGrid_ItemClick"
            CanDragItems="True"
            CanReorderItems="True"
            AllowDrop="True"
            DragItemsCompleted="ProfileGrid_DragItemsCompleted">

            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,0,12,12" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </GridView.ItemContainerStyle>

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:DisplayProfile">
                    <!-- No fixed Width: ProfileGrid_SizeChanged divides each row into
                         equal columns for the current window size, so cards grow to use
                         a narrow window instead of leaving a fixed 280px column and a
                         ragged edge. The active profile takes an accent border so
                         "which one am I on right now" is answerable at a glance. -->
                    <!-- The right-click menu and the "..." menu were two byte-identical
                         30-line MenuFlyout blocks; every menu change had to be made
                         twice. Both are now built once per card by BuildProfileMenu. -->
                    <Grid
                        MinHeight="220"
                        Padding="16"
                        CornerRadius="8"
                        Loaded="ProfileCard_Loaded"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{x:Bind local:ProfileListPage.CardBorder(IsActive), Mode=OneWay}"
                        BorderThickness="{x:Bind local:ProfileListPage.CardBorderThickness(IsActive), Mode=OneWay}">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <!-- 0: slot + name + overflow -->
                            <RowDefinition Height="*" />
                            <!-- 1: plan view, absorbs all slack -->
                            <RowDefinition Height="Auto" />
                            <!-- 2: caption + apply -->
                        </Grid.RowDefinitions>

                        <!-- Profile Name + Overflow Menu -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- The slot number IS the shortcut: this is the N in
                                     Ctrl+Alt+N. Shown only for the first nine, because
                                     only those have a shortcut to name. -->
                                <Border
                                    Visibility="{x:Bind local:ProfileListPage.SlotVisibility(SortOrder), Mode=OneWay}"
                                    Width="22" Height="22"
                                    CornerRadius="11"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    ToolTipService.ToolTip="{x:Bind local:ProfileListPage.SlotTooltip(SortOrder), Mode=OneWay}">
                                    <TextBlock
                                        Text="{x:Bind local:ProfileListPage.SlotNumber(SortOrder), Mode=OneWay}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Opacity="0.85" />
                                </Border>
                                <TextBlock
                                    Text="{x:Bind Name, Mode=OneWay}"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis" />
                                <Border
                                    Visibility="{x:Bind local:ProfileListPage.BoolToVisibility(IsActive), Mode=OneWay}"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{x:Bind local:ProfileListPage.L(local:ProfileListPage.ActiveKey)}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- Icon-only: without these it had no hover hint and a
                                 screen reader announced only "button". -->
                            <Button
                                Grid.Column="1"
                                Padding="4,2"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Top"
                                Click="MoreActionsButton_Click"
                                Tag="{x:Bind Id}"
                                ToolTipService.ToolTip="{x:Bind local:ProfileListPage.L(local:ProfileListPage.MoreActionsKey)}"
                                AutomationProperties.Name="{x:Bind local:ProfileListPage.L(local:ProfileListPage.MoreActionsKey)}">
                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                            </Button>
                        </Grid>

                        <!-- The plan view is the card. The arrangement is what
                             distinguishes one profile from another, so it takes the
                             space and everything else becomes caption. The monitor
                             count that used to sit above it said, in words, exactly
                             what the drawing now says. -->
                        <controls:MonitorLayoutThumbnail
                            Grid.Row="1"
                            Monitors="{x:Bind Monitors, Mode=OneWay}"
                            MinHeight="104"
                            Margin="0,12,0,10" />

                        <!-- Actions -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="1" Margin="0,0,8,0">
                                <!-- The user's own note, shown only when they wrote one. -->
                                <TextBlock
                                    Text="{x:Bind Description, Mode=OneWay}"
                                    Visibility="{x:Bind local:ProfileListPage.HasText(Description), Mode=OneWay}"
                                    Opacity="0.7"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                <!-- One caption line: how many monitors, when it changed,
                                     and the shortcut if it has one. -->
                                <TextBlock
                                    Text="{x:Bind local:ProfileListPage.CardCaption(MonitorCount, ModifiedAt, Hotkey), Mode=OneWay}"
                                    Opacity="0.55"
                                    TextTrimming="CharacterEllipsis"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                Tag="{x:Bind Id}"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="{x:Bind local:ProfileListPage.L(local:ProfileListPage.ApplyKey)}"
                                Click="ApplyButton_Click" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Empty State -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">

            <FontIcon Glyph="&#xE7F4;" FontSize="48" Opacity="0.3" />
            <TextBlock
                x:Name="EmptyTitleText"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Opacity="0.5"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="EmptyDescText"
                Opacity="0.4"
                TextWrapping="Wrap"
                TextAlignment="Center"
                MaxWidth="360"
                HorizontalAlignment="Center" />
            <!-- The empty state described the action but made the user go find the
                 button for it. Offer it right here. -->
            <Button
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"
                Click="SaveCurrentButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock x:Name="EmptyCtaText" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
