<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Mo.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:helpers="using:Mo.Helpers"
    xmlns:models="using:Mo.Models"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Transitions>
        <TransitionCollection>
            <EntranceThemeTransition />
        </TransitionCollection>
    </Page.Transitions>

    <ScrollViewer Padding="24">
        <StackPanel Spacing="4" MaxWidth="760" HorizontalAlignment="Stretch">

            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

            <!-- General -->
            <tk:SettingsExpander x:Uid="GeneralExpander" IsExpanded="True">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE713;" />
                </tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard x:Uid="LaunchAtStartupCard">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7E8;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.LaunchAtStartup, Mode=TwoWay}" OnContent="" OffContent="" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Uid="MinimizeToTrayCard">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.MinimizeToTrayOnClose, Mode=TwoWay}" OnContent="" OffContent="" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Uid="StartMinimizedCard">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE921;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}" OnContent="" OffContent="" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <!-- Appearance. Grouped rather than left as two loose cards between the
                 expanders above and below. The combos use the manual Loaded /
                 SelectionChanged wiring; SettingsPage.xaml.cs says why x:Bind is unsafe. -->
            <tk:SettingsExpander x:Uid="AppearanceExpander" IsExpanded="True">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard x:Uid="ThemeCard">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE771;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ThemeCombo"
                                  MinWidth="200"
                                  ItemsSource="{x:Bind ThemeOptions, Mode=OneTime}"
                                  DisplayMemberPath="Display"
                                  Loaded="ThemeCombo_Loaded"
                                  SelectionChanged="ThemeCombo_SelectionChanged" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Uid="LanguageCard">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xF2B7;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="LanguageCombo"
                                  MinWidth="200"
                                  ItemsSource="{x:Bind LanguageOptions, Mode=OneTime}"
                                  DisplayMemberPath="Display"
                                  Loaded="LanguageCombo_Loaded"
                                  SelectionChanged="LanguageCombo_SelectionChanged" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <!-- Profiles -->
            <tk:SettingsExpander x:Uid="ProfilesExpander" IsExpanded="True">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;" />
                </tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard x:Uid="AutoSwitchCard">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8AB;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.AutoSwitchEnabled, Mode=TwoWay}" OnContent="" OffContent="" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Uid="HotkeysCard">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE765;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.HotkeysEnabled, Mode=TwoWay}" OnContent="" OffContent="" />
                    </tk:SettingsCard>

                    <!-- Only present when Windows refused a binding. A shortcut that
                         silently never fires is indistinguishable from a broken app. -->
                    <tk:SettingsCard x:Name="HotkeyConflictCard" Visibility="Collapsed" ContentAlignment="Vertical">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </tk:SettingsCard.HeaderIcon>
                        <InfoBar x:Name="HotkeyConflictBar"
                                 Severity="Warning"
                                 IsOpen="True"
                                 IsClosable="False" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Uid="NextProfileHotkeyCard">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE893;" />
                        </tk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="NextHotkeyText" VerticalAlignment="Center" Opacity="0.85" />
                            <Button x:Name="NextHotkeyBtn" Click="NextHotkeyBtn_Click">
                                <TextBlock x:Uid="HotkeyChangeBtn" />
                            </Button>
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Uid="PrevProfileHotkeyCard">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE892;" />
                        </tk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="PrevHotkeyText" VerticalAlignment="Center" Opacity="0.85" />
                            <Button x:Name="PrevHotkeyBtn" Click="PrevHotkeyBtn_Click">
                                <TextBlock x:Uid="HotkeyChangeBtn" />
                            </Button>
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Uid="ProfileSlotHotkeyCard">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8FD;" />
                        </tk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="SlotHotkeyText" VerticalAlignment="Center" Opacity="0.85" />
                            <Button x:Name="SlotHotkeyBtn" Click="SlotHotkeyBtn_Click">
                                <TextBlock x:Uid="HotkeyChangeBtn" />
                            </Button>
                        </StackPanel>
                    </tk:SettingsCard>
                    <!-- Flat cards, not a nested SettingsExpander: SettingsExpander styles
                         every child in its Items collection as a SettingsCard, so nesting
                         one inside another throws at element-prepare time. -->
                    <tk:SettingsCard x:Uid="ConfirmApplyCard">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE946;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.ConfirmApply, Mode=TwoWay}" OnContent="" OffContent="" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Uid="RestoreOnStartupCard">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE777;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.RestoreOnStartup, Mode=TwoWay}" OnContent="" OffContent="" />
                    </tk:SettingsCard>
                    <!-- Only reachable through the startup restore above: this is the
                         applyColor argument to it, so on its own it does nothing. -->
                    <tk:SettingsCard x:Uid="RestoreColorCard"
                                     IsEnabled="{x:Bind ViewModel.RestoreOnStartup, Mode=OneWay}">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE793;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.RestoreColorOnStartup, Mode=TwoWay}" OnContent="" OffContent="" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Uid="ResetCursorAfterRotationCard">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE962;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.ResetCursorAfterRotation, Mode=TwoWay}" OnContent="" OffContent="" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <!-- Updates. One control per card: a switch that sets a preference and a
                 button that acts now are different promises, and pairing them in one row
                 made the switch look like it governed the button. -->
            <tk:SettingsExpander x:Uid="UpdatesExpander" IsExpanded="True">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard x:Uid="UpdateCheckCard">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xEA8F;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.CheckForUpdates, Mode=TwoWay}" OnContent="" OffContent="" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Uid="UpdateCheckNowCard">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE117;" />
                        </tk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="UpdateStatusText"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                       Visibility="Collapsed" />
                            <Button x:Name="CheckNowButton" Click="CheckNowButton_Click">
                                <TextBlock x:Uid="CheckNowText" />
                            </Button>
                        </StackPanel>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <!-- Advanced -->
            <!-- Hidden, not deleted. Every reason this setting existed failed
                 measurement; the code stays until a second machine confirms it.
                 See .claude/rules/30-display-apis.md. -->
            <tk:SettingsExpander x:Uid="AdvancedExpander" Visibility="Collapsed">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE9F5;" />
                </tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard x:Uid="RotationMethodCard">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7AD;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="RotationMethodCombo"
                                  MinWidth="200"
                                  ItemsSource="{x:Bind RotationOptions, Mode=OneTime}"
                                  DisplayMemberPath="DisplayName"
                                  Loaded="RotationMethodCombo_Loaded"
                                  SelectionChanged="RotationMethodCombo_SelectionChanged" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <!-- Uninstall cleanup. Neither the ZIP build (no installer) nor an
                 unpackaged run alongside MSIX removes %LOCALAPPDATA%\Mo or the
                 auto-start entry, so deleting the app folder used to leave both behind. -->
            <tk:SettingsCard x:Uid="RemoveDataCard">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE74D;" />
                </tk:SettingsCard.HeaderIcon>
                <Button x:Name="RemoveDataBtn" Click="RemoveData_Click">
                    <TextBlock x:Uid="RemoveDataButton"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </Button>
            </tk:SettingsCard>

            <!-- About / system info -->
            <tk:SettingsExpander x:Uid="AboutExpander">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </tk:SettingsExpander.HeaderIcon>
                <!-- ItemsHeader, not an item. The toolkit indents each item to line up
                     under the expander's own icon column, and this block carries no icon,
                     so that reserved column showed as an empty gutter down the left. -->
                <tk:SettingsExpander.ItemsHeader>
                    <!-- Painted to match the expander's own items. An ItemsHeader is laid
                         straight on the expanded area, which shows through darker than the
                         cards every other section here is made of. -->
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                    <StackPanel Spacing="20" Padding="16,16,16,16">

                            <!-- Identity -->
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Image x:Name="AboutIcon"
                                       Width="44" Height="44" VerticalAlignment="Center" />
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="AboutName" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="AboutVersion" Opacity="0.6"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="AboutDesc" Opacity="0.7" TextWrapping="Wrap" Margin="0,-8,0,0" />

                            <!-- This PC. A label/value grid rather than four loose lines,
                                 so the values line up and the labels can be read past. -->
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="SysSectionTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Grid ColumnSpacing="16" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="SysOsLabel" Opacity="0.6" />
                                    <TextBlock x:Name="SysOsText" Grid.Column="1" TextWrapping="Wrap" />

                                    <TextBlock x:Name="SysCpuLabel" Grid.Row="1" Opacity="0.6" />
                                    <TextBlock x:Name="SysCpuText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" />

                                    <TextBlock x:Name="SysRamLabel" Grid.Row="2" Opacity="0.6" />
                                    <TextBlock x:Name="SysRamText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" />

                                    <TextBlock x:Name="SysGpuLabel" Grid.Row="3" Opacity="0.6" />
                                    <TextBlock x:Name="SysGpuText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>

                            <TextBlock x:Name="SysMonitorsTitle" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Margin="0,0,0,-12" />
                            <!-- ItemsControl, not ItemsRepeater: a repeater virtualizes
                                 against the outer ScrollViewer and re-measures on every
                                 scroll tick here, which is the shimmer. -->
                            <ItemsControl x:Name="MonitorsList" ItemsSource="{x:Bind Monitors, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="helpers:MonitorDisplayInfo">
                                        <Border Padding="12,10"
                                                CornerRadius="6"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,1"
                                                            VerticalAlignment="Center"
                                                            Visibility="{x:Bind PrimaryBadgeVisibility}">
                                                        <TextBlock x:Uid="MonitorPrimaryBadge" FontSize="11"
                                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind ManufacturerModel}"
                                                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                                                <TextBlock Text="{x:Bind ResolutionLine}"
                                                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                                                <TextBlock Text="{x:Bind PositionLine}"
                                                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Diagnostics last, and grouped: these are for reporting a
                                 problem, not for reading the machine's specification. -->
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="SysDiagnosticsTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="CopySystemInfoBtn" Click="CopySystemInfo_Click"
                                            Style="{StaticResource AccentButtonStyle}">
                                        <TextBlock x:Uid="CopyDebugText" />
                                    </Button>
                                    <Button x:Name="ShowDebugBtn" Click="ShowDebugInfo_Click">
                                        <TextBlock x:Uid="ShowDebugText" />
                                    </Button>
                                    <Button x:Name="OpenLogFolderBtn" Click="OpenLogFolder_Click">
                                        <TextBlock x:Uid="OpenLogFolderText" />
                                    </Button>
                                </StackPanel>
                                <Border x:Name="SystemInfoBorder" Visibility="Collapsed"
                                        CornerRadius="6" Padding="4"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <TextBox x:Name="SystemInfoBox"
                                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                             IsSpellCheckEnabled="False"
                                             FontFamily="Consolas" FontSize="11" MaxHeight="300"
                                             BorderThickness="0" Background="Transparent" />
                                </Border>
                            </StackPanel>
                    </StackPanel>
                    </Border>
                </tk:SettingsExpander.ItemsHeader>
            </tk:SettingsExpander>

        </StackPanel>
    </ScrollViewer>
</Page>
