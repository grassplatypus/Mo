{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mo (unpackaged)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Mo/bin/x64/Debug/net10.0-windows10.0.26100.0/win-x64/Mo.exe",
      "cwd": "${workspaceFolder}/src/Mo",
      "console": "internalConsole",
      "stopAtEntry": false,
      "requireExactSource": false
    },
    {
      "name": "Mo (attach to running)",
      "type": "coreclr",
      "request": "attach",
      "processName": "Mo.exe"
    }
  ]
}
